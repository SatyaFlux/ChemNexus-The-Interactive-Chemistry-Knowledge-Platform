# ChemNexus Environment Variables

# Supabase Configuration (Required for cloud persistence & authentication)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional AI Assistant API Key (Used ONLY in Vercel Serverless Function /api/assistant)
# NEVER prefix private AI keys with VITE_ so they are never bundled into frontend JavaScript!
GEMINI_API_KEY=
# or OPENAI_API_KEY=

